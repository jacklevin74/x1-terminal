# Copy to .env (never commit .env). Only what you need for the mode you run.

# Claude API (paper/testnet trade reviews). Alternatively run `ant auth login`.
ANTHROPIC_API_KEY=

# Telegram alerts (set alerts.telegram_enabled: true in config.yaml)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Hyperliquid TESTNET only. Main account address + a separate approved AGENT wallet key file.
# The key file lives outside this repo, chmod 600, containing the 0x... private key.
HL_TESTNET_ACCOUNT_ADDRESS=
HL_TESTNET_AGENT_KEY_FILE=~/.config/hl-trader/testnet-agent.key

# Optional
LOG_LEVEL=INFO
# TRADER_CONFIG=/path/to/config.yaml

# Dashboard login (the dashboard is reachable from the internet)
DASHBOARD_PASSWORD=
