{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile --ignore-scripts",
  "buildCommand": "pnpm build",
  "outputDirectory": "apps/terminal/dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/copybot",
      "destination": "https://wxnt-sale-sim.vercel.app/api/copybot"
    },
    {
      "source": "/api/auto-trader-signal",
      "destination": "https://wxnt-sale-sim.vercel.app/api/daytraders"
    },
    {
      "source": "/analytics",
      "destination": "/analytics/index.html"
    },
    {
      "source": "/analytics/",
      "destination": "/analytics/index.html"
    },
    {
      "source": "/dashboard-view.js",
      "destination": "/analytics/dashboard-view.js"
    },
    {
      "source": "/analytics-portfolio.js",
      "destination": "/analytics/analytics-portfolio.js"
    },
    {
      "source": "/analytics.css",
      "destination": "/analytics/analytics.css"
    },
    {
      "source": "/analytics.js",
      "destination": "/analytics/analytics.js"
    },
    {
      "source": "/analytics-view.js",
      "destination": "/analytics/analytics-view.js"
    },
    {
      "source": "/((?!api/|dashboard-view\\.js$|analytics-portfolio\\.js$|analytics/|analytics\\.css$|analytics\\.js$|analytics-view\\.js$).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/builder-users.js": {
      "maxDuration": 60,
      "includeFiles": "server/analytics/published/**"
    },
    "api/analytics-update.js": {
      "maxDuration": 60
    },
    "api/ec2-keys.js": {
      "maxDuration": 30
    }
  }
}
