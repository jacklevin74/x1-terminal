{
  "name": "x1-terminal",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "pnpm --filter @hypeterminal/terminal dev",
    "build": "node scripts/prepare-analytics-assets.js && pnpm --filter @hypeterminal/terminal build",
    "build:terminal": "pnpm --filter @hypeterminal/terminal build",
    "build:website": "pnpm --filter @hypeterminal/website build",
    "build:all": "pnpm build:terminal && pnpm build:website",
    "serve": "pnpm --filter @hypeterminal/terminal serve",
    "test": "pnpm --filter @hypeterminal/terminal test",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify": "pnpm check && pnpm typecheck && pnpm test && pnpm build:all",
    "audit:prod": "pnpm audit --prod",
    "diagnostics:browser": "node scripts/browser-diagnostics.js",
    "validate:mobile-device": "node scripts/validate-mobile-phone-access-device-validation.js",
    "test:mobile-device-validator": "node --test scripts/validate-mobile-phone-access-device-validation.test.js",
    "template:mobile-device": "node scripts/validate-mobile-phone-access-device-validation.js --print-template",
    "init:mobile-device": "node scripts/validate-mobile-phone-access-device-validation.js --init-missing",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "fix": "biome check --write",
    "i18n:extract": "pnpm --filter @hypeterminal/terminal i18n:extract",
    "i18n:compile": "pnpm --filter @hypeterminal/terminal i18n:compile",
    "prepare": "node scripts/prepare-git-hooks.js",
    "deploy:vercel": "sh scripts/deploy-vercel.sh",
    "analytics:dev": "node --watch --env-file-if-exists=.env scripts/serve-analytics.js",
    "analytics:snapshot": "node --env-file-if-exists=.env scripts/prepare-analytics-snapshot.js",
    "analytics:remote-setup": "node --env-file-if-exists=.env scripts/configure-analytics-remote.js",
    "analytics:publish": "node --env-file-if-exists=.env scripts/publish-analytics.js",
    "analytics:sync": "npm run analytics:collect && npm run analytics:publish",
    "analytics:collect": "node --env-file-if-exists=.env scripts/collect-analytics.js",
    "analytics:import": "node --env-file-if-exists=.env scripts/import-analytics.js",
    "test:analytics": "node --test scripts/builder-analytics.test.js scripts/analytics-remote.test.js",
    "analytics:deploy": "npm run analytics:collect && npm run deploy:vercel",
    "api:agent": "node --env-file-if-exists=.env.agent apps/terminal/scripts/x1-agent.mjs",
    "test:api-agent": "node --test scripts/x1-agent-client.test.js"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "0.5.6",
    "@biomejs/biome": "2.2.4",
    "@commitlint/cli": "20.3.1",
    "@commitlint/config-conventional": "20.3.1",
    "lefthook": "1.11.0",
    "typescript": "5.7.2"
  },
  "pnpm": {
    "overrides": {
      "@noble/hashes": "1.8.0",
      "jayson>uuid": "11.1.1",
      "vite>esbuild": ">=0.28.1",
      "tsx>esbuild": ">=0.28.1",
      "esbuild": ">=0.28.1",
      "viem>ws": ">=8.21.0",
      "axios>form-data": ">=4.0.6",
      "axios": "^1.20.0",
      "postcss": ">=8.5.23",
      "js-yaml": "^4.3.2",
      "svgo": "^4.1.0",
      "sharp": "^0.35.5",
      "valibot": ">=1.4.2",
      "seroval": "^1.6.8",
      "follow-redirects": "^1.16.2",
      "bitcoinjs-lib": "^7.0.2",
      "browserslist": "^4.28.7",
      "baseline-browser-mapping": "^2.11.0",
      "devalue": "^5.9.3",
      "smol-toml": "^1.9.0",
      "source-map-js": "^1.2.2",
      "vite@>=7.0.0 <7.3.7": "^7.3.7",
      "vite@>=8.0.0 <8.2.4": "^8.2.4",
      "zod@>=4.0.0 <4.6.6": "^4.6.6"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-528h-pc64-c93x",
        "GHSA-hqr4-qq8f-hg3x",
        "GHSA-mjw6-4jj6-33hc",
        "GHSA-mrhx-c7xc-m3w5"
      ]
    }
  },
  "packageManager": "pnpm@10.34.9"
}
