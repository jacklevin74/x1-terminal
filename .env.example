# Optional public builder override. Defaults to the X1 address below; explicit zero/invalid values disable trading.
VITE_BUILDER_ADDRESS=0x95e1642b6c06e06e6ad9412a90e908dcb09f6c1a
# Defaults to testnet. Users can switch networks in Settings.
VITE_HYPERLIQUID_TESTNET=true

# Optional browser-accessible Solana mainnet RPC for the Phantom SOL send button.
# This URL is public in the bundle; do not put server-only secrets here.
VITE_SOLANA_RPC_URL=https://solana-rpc.publicnode.com

# Local-only analytics data. No RPC or API credentials are needed.
BUILDER_ANALYTICS_DATA_DIR=data/analytics
BUILDER_ANALYTICS_ADDRESS=0x95e1642B6C06E06E6ad9412A90e908Dcb09f6c1a

# Used only by the background collector; the JSON API does not use this key.
QUICKNODE_SQL_API_KEY=
BUILDER_ANALYTICS_START_DATE=2026-10-29

# Remote analytics publishing. Server/local secrets only, never VITE_.
ANALYTICS_REMOTE_URL=
ANALYTICS_PUBLISH_TOKEN=
# Vercel adds this when a private Blob store is connected to the project.
BLOB_READ_WRITE_TOKEN=

# Remote analytics: Neon PostgreSQL URL (server only; set in Vercel Production).
# DATABASE_URL=postgresql://USER:PASSWORD@ep-PROJECT.REGION.aws.neon.tech/DB?sslmode=require
# Optional dedicated analytics database; takes precedence over DATABASE_URL.
# ANALYTICS_DATABASE_URL=

# Agent CLI uses a separate, ignored .env.agent file downloaded from /API.
# X1_ACCOUNT_ADDRESS=0xYOUR_PUBLIC_OWNER_ACCOUNT
# X1_AGENT_PRIVATE_KEY=0xYOUR_TRADING_ONLY_AGENT_SECRET
# X1_NETWORK=mainnet

# Public Auto Trader control API; defaults to the existing Neon/executor service.
# No database, executor, HMAC, wrapping key, or owner private key belongs in VITE_ vars.
VITE_COPYBOT_API=/api/copybot
