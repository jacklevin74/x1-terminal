# Public builder address only. Missing/zero/invalid address disables setup and orders.
VITE_BUILDER_ADDRESS=
# Defaults to testnet. Users can switch networks in Settings.
VITE_HYPERLIQUID_TESTNET=true

# Optional browser-accessible Solana mainnet RPC for the Phantom SOL send button.
# This URL is public in the bundle; do not put server-only secrets here.
VITE_SOLANA_RPC_URL=https://solana-rpc.publicnode.com
