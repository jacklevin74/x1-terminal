# /etc/caddy/Caddyfile — replace KEYS_HOST with the chosen hostname (e.g. keys-api.example.com).
# Only TCP 443 needs to be open: certificates use the TLS-ALPN challenge, and no HTTP redirect is served.
{
	auto_https disable_redirects
}

KEYS_HOST {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}
	encode zstd gzip
	request_body {
		max_size 8KB
	}
	@api path /api/ec2-keys /health
	handle @api {
		reverse_proxy 127.0.0.1:8790 {
			# Keep the proxy's X-Forwarded-For and append the real peer. The service uses the last entry for
			# unauthenticated limits and trusts the first (browser) entry only after the proxy HMAC verifies.
			trusted_proxies 0.0.0.0/0 ::/0
			transport http {
				dial_timeout 2s
				response_header_timeout 25s
			}
		}
	}
	handle {
		respond 404
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}
	log {
		output file /var/log/caddy/keys-api.log {
			roll_size 10MiB
			roll_keep 10
		}
		# Never log owner signatures or proxy MACs.
		format filter {
			wrap json
			fields {
				request>headers>X-Auth delete
				request>headers>X-Proxy-Auth delete
				request>headers>X-Proxy-Ts delete
				request>headers>Cookie delete
			}
		}
	}
}
