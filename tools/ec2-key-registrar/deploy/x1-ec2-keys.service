[Unit]
Description=X1 Terminal EC2 KMS key service (owner-signed create and lifecycle; no signing)
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=x1-ec2-keys
Group=x1-ec2-keys
WorkingDirectory=/opt/x1-ec2-keys
Environment=NODE_ENV=production
Environment=AWS_REGION=us-east-2
Environment=X1_KEYS_ENV=prod
Environment=X1_KEYS_DB=/var/lib/x1-ec2-keys/keys.sqlite
Environment=X1_AUDIT_LOG=/var/lib/x1-ec2-keys/audit.jsonl
# CloudFront → Caddy: Caddy appends the CloudFront edge address as one trusted hop.
Environment=X1_TRUSTED_HOPS=1
# X1_REGISTRAR_ROLE_ARN and X1_LIFECYCLE_ROLE_ARN (kept out of the repository).
EnvironmentFile=/etc/x1-ec2-keys/env
# Proxy HMAC secrets: 32 random bytes in hex, mode 0600. Never printed or logged.
LoadCredential=proxy.secret:/etc/x1-ec2-keys/proxy.secret
LoadCredential=proxy-preview.secret:/etc/x1-ec2-keys/proxy-preview.secret
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning /opt/x1-ec2-keys/src/server.js
Restart=on-failure
RestartSec=10
UMask=0077
StateDirectory=x1-ec2-keys
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
[Install]
WantedBy=multi-user.target
